{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",

  "redirects": [
    {
      "source": "/drawbridge.html",
      "destination": "/work/drawbridge/",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "statusCode": 301
    }
  ]
}
