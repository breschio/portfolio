---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import Subscribe from '../../components/Subscribe.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0)
);
---

<Base
  title="Learn — Terrence Breschi"
  description="Lessons on building with AI, for designers who want to ship real things."
  section="learn"
>
  <div class="page-header">
    <h2>learn</h2>
    <p>
      Lessons on building with AI, for designers who want to ship real things.
      Every one ends with you having made something.
    </p>
  </div>

  {lessons.length > 0 ? (
    <EntryList
      items={lessons.map((entry) => ({
        href: `/learn/${entry.id}/`,
        meta: entry.data.episode ? `ep. ${entry.data.episode}` : '',
        title: entry.data.title,
        summary: entry.data.description,
      }))}
    />
  ) : (
    <p class="entry-summary">The first lesson is being written.</p>
  )}

  <Subscribe />
</Base>
