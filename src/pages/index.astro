---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import Subscribe from '../components/Subscribe.astro';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base
  title="Terrence Breschi — design, build and ship with AI"
  description="Terrence Breschi designs, builds and ships with AI. Selected work, writing on the craft, and lessons on building with AI."
>
  <div class="page-header">
    <h2>design, build and ship with ai</h2>
    <p class="lede">
      I lead product design, build prototypes, ship code, and teach others. Selected
      work below, plus what I'm writing and what I'm teaching.
    </p>
  </div>

  <section>
    <div class="page-header">
      <h2>work</h2>
    </div>
    <EntryList
      items={work.map((entry) => ({
        href: `/work/${entry.id}/`,
        meta: String(entry.data.year),
        title: entry.data.title,
        summary: entry.data.description,
      }))}
    />
    <p class="link-container"><a href="/work/" class="project-link">all work</a></p>
  </section>

  {writing.length > 0 && (
    <section>
      <div class="page-header">
        <h2>writing</h2>
      </div>
      <EntryList
        items={writing.map((entry) => ({
          href: `/writing/${entry.id}/`,
          meta: entry.data.pubDate.toISOString().slice(0, 10),
          title: entry.data.title,
          summary: entry.data.description,
        }))}
      />
      <p class="link-container"><a href="/writing/" class="project-link">all writing</a></p>
    </section>
  )}

  <Subscribe />
</Base>
