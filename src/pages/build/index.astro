---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const entries = (await getCollection('build', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Build log — Terrence Breschi"
  description="A running log of things I've built: small tools, experiments, and side projects."
>
  <div class="page-header">
    <h2>build log</h2>
    <p>Small things I've built. Not case studies — just what it is and where the code lives.</p>
  </div>

  <EntryList
    items={entries.map((entry) => ({
      href: `/build/${entry.id}/`,
      meta: entry.data.date.toISOString().slice(0, 10),
      title: entry.data.title,
      summary: entry.data.description,
    }))}
  />
</Base>
