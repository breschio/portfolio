---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to the share image. */
  image?: string;
  canonical?: string;
  /** Set on the one page whose nav item should read as current. */
  section?: 'work' | 'writing' | 'build' | 'learn' | 'about';
}

const {
  title,
  description,
  image = '/assets/terrence-breschi-profile.png',
  canonical,
  section,
} = Astro.props;

const canonicalHref = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageHref = new URL(image, Astro.site).href;

const nav = [
  { href: '/work/', label: 'work', key: 'work' },
  { href: '/writing/', label: 'writing', key: 'writing' },
  { href: '/build/', label: 'build', key: 'build' },
  { href: '/learn/', label: 'learn', key: 'learn' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GFN119M0JG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-GFN119M0JG');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageHref} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="alternate" type="application/rss+xml" title="bresch.io" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Applied before paint so a saved theme does not flash the wrong one. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t) document.documentElement.setAttribute('data-initial-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <button class="hamburger-menu" aria-label="Toggle menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="12" x2="20" y2="12" class="line-top" />
        <line x1="4" y1="12" x2="20" y2="12" class="line-middle" />
        <line x1="4" y1="12" x2="20" y2="12" class="line-bottom" />
      </svg>
    </button>

    <div class="container">
      <nav class="sidebar" aria-label="Main">
        <h1><a href="/">bresch.io</a></h1>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="about-me">
          <img src="/assets/terrence-breschi-profile.png" alt="Terrence Breschi" class="avatar" width="40" height="40" loading="lazy" />
          <p>hey, i'm terrence. i design, build and ship with ai.</p>
          <div class="about-row">
            <a href="/about/" class="about-link" aria-current={section === 'about' ? 'page' : undefined}>about</a>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sun-icon">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 3v1" /><path d="M12 20v1" /><path d="M3 12h1" /><path d="M20 12h1" />
                <path d="m18.364 5.636-.707.707" /><path d="m6.343 17.657-.707.707" />
                <path d="m5.636 5.636.707.707" /><path d="m17.657 17.657.707.707" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="moon-icon">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <main class="content" id="main">
        <slot />
      </main>
    </div>

    <script is:inline>
      (function () {
        var body = document.body;
        var initial = document.documentElement.getAttribute('data-initial-theme');
        if (initial) body.classList.add(initial);

        var toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = body.classList.contains('dark-theme') ||
              (prefersDark && !body.classList.contains('light-theme'));
            var next = isDark ? 'light-theme' : 'dark-theme';
            body.classList.remove('light-theme', 'dark-theme');
            body.classList.add(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }

        var burger = document.querySelector('.hamburger-menu');
        var sidebar = document.querySelector('.sidebar');
        if (burger && sidebar) {
          burger.addEventListener('click', function () {
            var open = sidebar.classList.toggle('open');
            burger.classList.toggle('active', open);
            burger.setAttribute('aria-expanded', String(open));
          });
        }
      })();
    </script>
  </body>
</html>
